# =========================
# NOBITEX API
# =========================
NOBITEX_API_KEY=your_nobitex_api_key_here

# =========================
# BALE MESSENGER (پیام‌رسان بله)
# =========================
BALE_BOT_TOKEN=your_bale_bot_token_here
BALE_CHAT_ID=your_bale_chat_id_here

# =========================
# AI - Gemini (رایگان و بدون نیاز به کارت بانکی)
# =========================
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=AQ.YourGeminiKeyHere
AI_REQUIRED=false
ENABLE_AI_ANALYSIS=true

# =========================
# TEST MODE (true/false)
# =========================
TEST_MODE=false

# =========================
# LOG LEVEL (DEBUG/INFO/WARNING/ERROR)
# =========================
LOG_LEVEL=INFO
